# Colorlight 5A-75B revisión 8.0 — LFE5U-25F-6BG256C (CABGA256, speed 6)
#
# Pinout completo para el driver propio: reloj, botón y los 56 pines de los
# ocho conectores HUB75. Fuente: chubby75 hardware_V8.0.md vía
# ../docs/12_referencias_tecnicas.md §2.
#
# ATENCIÓN con los nombres: chubby75 llama R0/G0/B0 a la mitad superior
# (R1/G1/B1 de HUB75) y R1/G1/B1 a la inferior (R2/G2/B2). Acá se usa la
# nomenclatura HUB75 estándar de docs/08: jN_r1/g1/b1 = mitad superior,
# jN_r2/g2/b2 = mitad inferior.
#
# A/B/C llevan el paso de dirección (scan 1/8); D/E quedan sin uso y se
# atan a 0 en el RTL. CLK, LAT y OE son compartidas por los ocho conectores.

# --- Reloj: 25 MHz generados por el PHY U13 --------------------------------
LOCATE COMP "clk25" SITE "P6";
IOBUF  PORT "clk25" IO_TYPE=LVCMOS33;
FREQUENCY PORT "clk25" 25 MHz;

# --- Botón de usuario: activo bajo -----------------------------------------
LOCATE COMP "btn_n" SITE "R7";
IOBUF  PORT "btn_n" IO_TYPE=LVCMOS33 PULLMODE=UP;

# --- Señales compartidas por los ocho conectores ---------------------------
LOCATE COMP "hub_a"   SITE "N5";
LOCATE COMP "hub_b"   SITE "N3";
LOCATE COMP "hub_c"   SITE "P3";
LOCATE COMP "hub_d"   SITE "P4";
LOCATE COMP "hub_e"   SITE "N4";
LOCATE COMP "hub_clk" SITE "M3";
LOCATE COMP "hub_lat" SITE "N1";
LOCATE COMP "hub_oe"  SITE "M4";

# --- J1 --------------------------------------------------------------------
LOCATE COMP "j1_r1" SITE "C4";
LOCATE COMP "j1_g1" SITE "D4";
LOCATE COMP "j1_b1" SITE "E4";
LOCATE COMP "j1_r2" SITE "D3";
LOCATE COMP "j1_g2" SITE "F5";
LOCATE COMP "j1_b2" SITE "E3";

# --- J2 --------------------------------------------------------------------
LOCATE COMP "j2_r1" SITE "F1";
LOCATE COMP "j2_g1" SITE "F2";
LOCATE COMP "j2_b1" SITE "G2";
LOCATE COMP "j2_r2" SITE "G1";
LOCATE COMP "j2_g2" SITE "H2";
LOCATE COMP "j2_b2" SITE "H3";

# --- J3 --------------------------------------------------------------------
LOCATE COMP "j3_r1" SITE "B1";
LOCATE COMP "j3_g1" SITE "C2";
LOCATE COMP "j3_b1" SITE "C1";
LOCATE COMP "j3_r2" SITE "D1";
LOCATE COMP "j3_g2" SITE "E2";
LOCATE COMP "j3_b2" SITE "E1";

# --- J4 --------------------------------------------------------------------
LOCATE COMP "j4_r1" SITE "P5";
LOCATE COMP "j4_g1" SITE "R3";
LOCATE COMP "j4_b1" SITE "P2";
LOCATE COMP "j4_r2" SITE "R2";
LOCATE COMP "j4_g2" SITE "T2";
LOCATE COMP "j4_b2" SITE "N6";

# --- J5 --------------------------------------------------------------------
LOCATE COMP "j5_r1" SITE "T13";
LOCATE COMP "j5_g1" SITE "R12";
LOCATE COMP "j5_b1" SITE "R13";
LOCATE COMP "j5_r2" SITE "R14";
LOCATE COMP "j5_g2" SITE "T14";
LOCATE COMP "j5_b2" SITE "P12";

# --- J6 --------------------------------------------------------------------
LOCATE COMP "j6_r1" SITE "R15";
LOCATE COMP "j6_g1" SITE "T15";
LOCATE COMP "j6_b1" SITE "P13";
LOCATE COMP "j6_r2" SITE "P14";
LOCATE COMP "j6_g2" SITE "N14";
LOCATE COMP "j6_b2" SITE "H15";

# --- J7 --------------------------------------------------------------------
LOCATE COMP "j7_r1" SITE "G16";
LOCATE COMP "j7_g1" SITE "H14";
LOCATE COMP "j7_b1" SITE "G15";
LOCATE COMP "j7_r2" SITE "F15";
LOCATE COMP "j7_g2" SITE "F16";
LOCATE COMP "j7_b2" SITE "E16";

# --- J8 --------------------------------------------------------------------
LOCATE COMP "j8_r1" SITE "D16";
LOCATE COMP "j8_g1" SITE "E15";
LOCATE COMP "j8_b1" SITE "C16";
LOCATE COMP "j8_r2" SITE "B16";
LOCATE COMP "j8_g2" SITE "C15";
LOCATE COMP "j8_b2" SITE "B15";

# --- Estilo de E/S ----------------------------------------------------------
IOBUF PORT "hub_a"   IO_TYPE=LVCMOS33 DRIVE=8 SLEWRATE=FAST;
IOBUF PORT "hub_b"   IO_TYPE=LVCMOS33 DRIVE=8 SLEWRATE=FAST;
IOBUF PORT "hub_c"   IO_TYPE=LVCMOS33 DRIVE=8 SLEWRATE=FAST;
IOBUF PORT "hub_d"   IO_TYPE=LVCMOS33 DRIVE=8 SLEWRATE=FAST;
IOBUF PORT "hub_e"   IO_TYPE=LVCMOS33 DRIVE=8 SLEWRATE=FAST;
IOBUF PORT "hub_clk" IO_TYPE=LVCMOS33 DRIVE=8 SLEWRATE=FAST;
IOBUF PORT "hub_lat" IO_TYPE=LVCMOS33 DRIVE=8 SLEWRATE=FAST;
IOBUF PORT "hub_oe"  IO_TYPE=LVCMOS33 DRIVE=8 SLEWRATE=FAST;
IOBUF PORT "j1_r1" IO_TYPE=LVCMOS33 DRIVE=8 SLEWRATE=FAST;
IOBUF PORT "j1_g1" IO_TYPE=LVCMOS33 DRIVE=8 SLEWRATE=FAST;
IOBUF PORT "j1_b1" IO_TYPE=LVCMOS33 DRIVE=8 SLEWRATE=FAST;
IOBUF PORT "j1_r2" IO_TYPE=LVCMOS33 DRIVE=8 SLEWRATE=FAST;
IOBUF PORT "j1_g2" IO_TYPE=LVCMOS33 DRIVE=8 SLEWRATE=FAST;
IOBUF PORT "j1_b2" IO_TYPE=LVCMOS33 DRIVE=8 SLEWRATE=FAST;
IOBUF PORT "j2_r1" IO_TYPE=LVCMOS33 DRIVE=8 SLEWRATE=FAST;
IOBUF PORT "j2_g1" IO_TYPE=LVCMOS33 DRIVE=8 SLEWRATE=FAST;
IOBUF PORT "j2_b1" IO_TYPE=LVCMOS33 DRIVE=8 SLEWRATE=FAST;
IOBUF PORT "j2_r2" IO_TYPE=LVCMOS33 DRIVE=8 SLEWRATE=FAST;
IOBUF PORT "j2_g2" IO_TYPE=LVCMOS33 DRIVE=8 SLEWRATE=FAST;
IOBUF PORT "j2_b2" IO_TYPE=LVCMOS33 DRIVE=8 SLEWRATE=FAST;
IOBUF PORT "j3_r1" IO_TYPE=LVCMOS33 DRIVE=8 SLEWRATE=FAST;
IOBUF PORT "j3_g1" IO_TYPE=LVCMOS33 DRIVE=8 SLEWRATE=FAST;
IOBUF PORT "j3_b1" IO_TYPE=LVCMOS33 DRIVE=8 SLEWRATE=FAST;
IOBUF PORT "j3_r2" IO_TYPE=LVCMOS33 DRIVE=8 SLEWRATE=FAST;
IOBUF PORT "j3_g2" IO_TYPE=LVCMOS33 DRIVE=8 SLEWRATE=FAST;
IOBUF PORT "j3_b2" IO_TYPE=LVCMOS33 DRIVE=8 SLEWRATE=FAST;
IOBUF PORT "j4_r1" IO_TYPE=LVCMOS33 DRIVE=8 SLEWRATE=FAST;
IOBUF PORT "j4_g1" IO_TYPE=LVCMOS33 DRIVE=8 SLEWRATE=FAST;
IOBUF PORT "j4_b1" IO_TYPE=LVCMOS33 DRIVE=8 SLEWRATE=FAST;
IOBUF PORT "j4_r2" IO_TYPE=LVCMOS33 DRIVE=8 SLEWRATE=FAST;
IOBUF PORT "j4_g2" IO_TYPE=LVCMOS33 DRIVE=8 SLEWRATE=FAST;
IOBUF PORT "j4_b2" IO_TYPE=LVCMOS33 DRIVE=8 SLEWRATE=FAST;
IOBUF PORT "j5_r1" IO_TYPE=LVCMOS33 DRIVE=8 SLEWRATE=FAST;
IOBUF PORT "j5_g1" IO_TYPE=LVCMOS33 DRIVE=8 SLEWRATE=FAST;
IOBUF PORT "j5_b1" IO_TYPE=LVCMOS33 DRIVE=8 SLEWRATE=FAST;
IOBUF PORT "j5_r2" IO_TYPE=LVCMOS33 DRIVE=8 SLEWRATE=FAST;
IOBUF PORT "j5_g2" IO_TYPE=LVCMOS33 DRIVE=8 SLEWRATE=FAST;
IOBUF PORT "j5_b2" IO_TYPE=LVCMOS33 DRIVE=8 SLEWRATE=FAST;
IOBUF PORT "j6_r1" IO_TYPE=LVCMOS33 DRIVE=8 SLEWRATE=FAST;
IOBUF PORT "j6_g1" IO_TYPE=LVCMOS33 DRIVE=8 SLEWRATE=FAST;
IOBUF PORT "j6_b1" IO_TYPE=LVCMOS33 DRIVE=8 SLEWRATE=FAST;
IOBUF PORT "j6_r2" IO_TYPE=LVCMOS33 DRIVE=8 SLEWRATE=FAST;
IOBUF PORT "j6_g2" IO_TYPE=LVCMOS33 DRIVE=8 SLEWRATE=FAST;
IOBUF PORT "j6_b2" IO_TYPE=LVCMOS33 DRIVE=8 SLEWRATE=FAST;
IOBUF PORT "j7_r1" IO_TYPE=LVCMOS33 DRIVE=8 SLEWRATE=FAST;
IOBUF PORT "j7_g1" IO_TYPE=LVCMOS33 DRIVE=8 SLEWRATE=FAST;
IOBUF PORT "j7_b1" IO_TYPE=LVCMOS33 DRIVE=8 SLEWRATE=FAST;
IOBUF PORT "j7_r2" IO_TYPE=LVCMOS33 DRIVE=8 SLEWRATE=FAST;
IOBUF PORT "j7_g2" IO_TYPE=LVCMOS33 DRIVE=8 SLEWRATE=FAST;
IOBUF PORT "j7_b2" IO_TYPE=LVCMOS33 DRIVE=8 SLEWRATE=FAST;
IOBUF PORT "j8_r1" IO_TYPE=LVCMOS33 DRIVE=8 SLEWRATE=FAST;
IOBUF PORT "j8_g1" IO_TYPE=LVCMOS33 DRIVE=8 SLEWRATE=FAST;
IOBUF PORT "j8_b1" IO_TYPE=LVCMOS33 DRIVE=8 SLEWRATE=FAST;
IOBUF PORT "j8_r2" IO_TYPE=LVCMOS33 DRIVE=8 SLEWRATE=FAST;
IOBUF PORT "j8_g2" IO_TYPE=LVCMOS33 DRIVE=8 SLEWRATE=FAST;
IOBUF PORT "j8_b2" IO_TYPE=LVCMOS33 DRIVE=8 SLEWRATE=FAST;

# --- LED de usuario: pin en disputa entre fuentes (T6 vs P11) ----------------
# El top maneja los dos a propósito (latido de frame) para resolverlo sobre
# la placa, igual que blinky-5a75b/.
LOCATE COMP "led_t6"  SITE "T6";
IOBUF  PORT "led_t6"  IO_TYPE=LVCMOS33 DRIVE=8;
LOCATE COMP "led_p11" SITE "P11";
IOBUF  PORT "led_p11" IO_TYPE=LVCMOS33 DRIVE=8;
